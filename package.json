{
  "name": "capper-ui",
  "private": true,
  "version": "0.0.1",
  "description": "Capper UI design system",
  "license": "MIT",
  "scripts": {
    "build": "pnpm -r --filter='./packages/*' run build",
    "build:docs": "pnpm --filter @capper-ui/react build && pnpm --filter @capper-ui/docs build",
    "dev": "pnpm --filter @capper-ui/docs run dev",
    "storybook": "pnpm --filter @capper-ui/docs run storybook",
    "test": "pnpm -r --filter='./packages/*' run test",
    "test:watch": "pnpm -r --filter='./packages/*' run test:watch",
    "test:coverage": "pnpm -r --filter='./packages/*' run test:coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:css": "stylelint 'packages/**/*.css'",
    "lint:css:fix": "stylelint 'packages/**/*.css' --fix",
    "format": "biome format --write .",
    "typecheck": "pnpm -r --filter='./packages/*' run typecheck",
    "clean": "pnpm -r --filter='./packages/*' run clean"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "stylelint": "^16.11.0",
    "stylelint-config-standard": "^36.0.1",
    "typescript": "^5.7.2"
  },
  "engines": {
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.9"
}
