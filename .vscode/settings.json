{
  "editor.defaultFormatter": "biomejs.biome",
  "editor.formatOnSave": true,
  "[css]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "css.validate": false,
  "stylelint.validate": ["css"],
  "editor.codeActionsOnSave": {
    "source.fixAll.biome": "explicit",
    "source.fixAll.stylelint": "explicit"
  },
  "vitest.enable": true,
  "vitest.maximumConfigs": 10
}
